rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    match /quizverse_users/{uid}/entries/{entry} {
      allow read: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasAll(['value', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['value', 'updatedAt', 'deleted'])
        && request.resource.data.updatedAt is number
        && request.resource.data.updatedAt > 0
        && request.resource.data.updatedAt <= request.time.toMillis() + 300000
        && (!('deleted' in request.resource.data) || request.resource.data.deleted is bool)
        && (!exists(/databases/$(database)/documents/quizverse_users/$(uid)/entries/$(entry))
          || request.resource.data.updatedAt >= resource.data.updatedAt);
      allow delete: if owner(uid);
    }
    match /quizverse_scores/{scoreId} {
      function validScore() {
        let d = request.resource.data;
        return d.keys().hasAll(['uid', 'displayName', 'category', 'title', 'score', 'total', 'seconds', 'date'])
          && d.keys().hasOnly(['uid', 'displayName', 'category', 'title', 'score', 'total', 'seconds', 'date'])
          && owner(d.uid)
          && d.displayName is string && d.displayName.size() > 0 && d.displayName.size() <= 60
          && d.category is string && d.category.size() > 0 && d.category.size() <= 100
          && d.title is string && d.title.size() > 0 && d.title.size() <= 120
          && d.score is int && d.total is int && d.total > 0 && d.total <= 10
          && d.score >= 0 && d.score <= d.total
          && d.seconds is int && d.seconds >= 0 && d.seconds <= 86400
          && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$');
      }
      allow get: if true;
      allow list: if request.query.limit != null && request.query.limit <= 100;
      allow create: if validScore();
      allow update: if owner(resource.data.uid) && validScore() && request.resource.data.uid == resource.data.uid;
      allow delete: if owner(resource.data.uid);
    }
    // No access to undeclared collections. Merge these explicit paths into existing
    // production rules if other applications share this Firebase project.
    match /{document=**} { allow read, write: if false; }
  }
}
