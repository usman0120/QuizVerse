# Browser configuration (Firebase web-app settings; these are not admin secrets).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server only. Never prefix these with NEXT_PUBLIC_.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the key quoted and encode newlines as \n when using .env.local.
FIREBASE_PRIVATE_KEY=
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QUIZ_SESSION_SECRET=

# Optional public contact address. No fake submission form is enabled.
NEXT_PUBLIC_CONTACT_EMAIL=
