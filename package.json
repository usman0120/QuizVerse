{
  "name": "quizverse",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:production": "node scripts/smoke-production.mjs",
    "audit:data": "node scripts/audit-data.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource/noto-nastaliq-urdu": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "firebase": "^13.2.0",
    "firebase-admin": "^14.5.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7",
    "@typescript-eslint/typescript-estree": { "minimatch": "^11.0.5" },
    "browserslist": "^4.29.5",
    "micromatch": { "picomatch": "^2.3.2" },
    "source-map-js": "^1.2.2",
    "rimraf": "^6.1.4",
